      "css": ".ds-card{width:208px;height:264px;padding:12px;display:flex;flex-direction:column;align-items:stretch;gap:12px;text-align:left;border:0;background:#fff;border-radius:12px;box-shadow:0 3px 8px #273b2b0d,0 12px 24px #273b2b09;cursor:pointer;transition:box-shadow .2s,opacity .2s,background .2s}.ds-card:hover{background:#fffefa;box-shadow:0 5px 12px #273b2b15,0 16px 30px #273b2b13}.ds-card.is-selected{outline:2px solid #315b49;outline-offset:3px;background:#fff}.ds-card.is-dimmed{opacity:.38}.ds-portrait{display:grid;place-items:center;width:184px;height:154px;flex-shrink:0;border-radius:5px;background:#edf0e9;color:#8b9489;font:24px Lora,Georgia,serif}.ds-copy{display:flex;flex-direction:column;gap:7px}.ds-surname{font:500 10px/1.2 \"Golos Text\",sans-serif;letter-spacing:.09em;text-transform:uppercase;color:#596b5e}.ds-name{font:400 17px/1.25 Lora,Georgia,serif;color:#293730;overflow-wrap:anywhere}.ds-years{font:10px/1.4 \"Golos Text\",sans-serif;color:#636d66;font-variant-numeric:tabular-nums}.ds-card:focus-visible { outline:2px solid var(--terra,#315b49);outline-offset:4px; }@media(prefers-reduced-motion:reduce){.ds-primary,.ds-ghost,.ds-card,.ds-status{transition:none}}"
